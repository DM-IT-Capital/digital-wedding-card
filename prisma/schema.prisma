generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CREATOR
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(CREATOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cards        WeddingCard[] @relation("CreatedBy")
}

model WeddingCard {
  id                     String   @id @default(cuid())
  slug                   String   @unique
  isPublished            Boolean  @default(false)

  customerName           String
  customerEmail          String?
  customerPhone          String?

  groomFullName          String
  brideFullName          String
  groomParents           String?
  brideParents           String?

  eventDate              String
  eventDay               String?
  eventTime              String
  eventType              String
  venueName              String
  venueAddress           String
  mapLink                String?

  rsvpName               String?
  rsvpPhone              String?
  rsvpDeadline           String?

  themeColor             String?
  style                  String?
  tone                   String?
  designReference        String?

  hasPhotos              Boolean  @default(false)
  photoUrls              String[]
  videoUrl               String?
  invitationText         String?

  bankAccountNumber      String?
  bankName               String?
  duitNowQrUrl           String?

  dressCodeColor         String?
  dressCodeType          String?

  backgroundMusicUrl     String?
  animationVideoInvite   Boolean  @default(false)
  countdownEnabled       Boolean  @default(false)
  qrRsvpUrl              String?
  navigationButton       Boolean  @default(true)

  enquiryName            String?
  enquiryPhone           String?
  enquiryEmail           String?
  enquiryWhatsappLink    String?

  createdById            String
  createdBy              User     @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}
